<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F1A">

    <!-- ROUND TEXT -->
    <TextView
        android:id="@+id/tvRound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ROUND 1/5"
        android:textColor="#6B7280"
        android:textSize="14sp"
        android:layout_margin="24dp"
        android:layout_gravity="top|end"/>

    <!-- CENTERED CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center"
        android:paddingHorizontal="40dp">

        <!-- RESULT -->
        <!-- RESULT with letter-tracing glow -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <!-- Glow layer 1 (outer, softer) -->
            <TextView
                android:id="@+id/tvResultGlow1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRUTH"
                android:textSize="72sp"
                android:textStyle="bold"
                android:textColor="#00FF88"
                android:alpha="0.3"
                android:shadowColor="#00FF88"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="5"
                android:layout_gravity="center"/>

            <!-- Main text -->
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRUTH"
                android:textSize="72sp"
                android:padding="6dp"
                android:textStyle="bold"
                android:textColor="#00FF88"
                android:shadowColor="#AAFFDF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:layout_gravity="center"/>
        </FrameLayout>

        <!-- STATEMENT -->
        <TextView
            android:id="@+id/tvStatement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Statement"
            android:textColor="#9CA3AF"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="40dp"/>

        <!-- PLAYERS -->
        <LinearLayout
            android:id="@+id/playersContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="60dp"/>

        <!-- BUTTON -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="300dp"
            android:layout_height="65dp"
            android:background="@drawable/btn_primary"
            android:text="Next Round"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="50dp"
            android:textColor="#FFFFFF"
            android:focusable="true"/>
    </LinearLayout>

</FrameLayout>